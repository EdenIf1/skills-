{
  "name": "blockfire-app",
  "version": "1.8.0",
  "private": true,
  "description": "Blockfire for iPhone (Capacitor wrapper around the web game)",
  "scripts": {
    "www": "python3 ../build/build.py ../game/cabin-fever.html www --native",
    "sync": "npm run www && npx cap sync ios",
    "bundle": "node scripts/make-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-updater": "8.52.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
